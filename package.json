{
  "name": "dsh-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://deepseek1024.com/",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "plugin:collect": "node scripts/collect-dsh-plugins.mjs",
    "plugin:review": "node scripts/review-plugin-submission.mjs",
    "test:plugin-collector": "node --test scripts/collect-dsh-plugins.test.mjs",
    "test:plugin-review": "node --test scripts/review-plugin-submission.test.mjs",
    "test:submit-skill": "node --test scripts/submit-dsh-plugin-skill.test.mjs",
    "dev": "npm run dev --workspace @dsh-store/web",
    "build": "npm run build --workspace @dsh-store/web",
    "typecheck": "npm run typecheck --workspace @dsh-store/web",
    "test": "npm run test:plugin-collector && npm run test:plugin-review && npm run test:submit-skill && npm run test --workspace @dsh-store/web",
    "test:visual": "npm run test:visual --workspace @dsh-store/web",
    "cf-typegen": "npm run cf-typegen --workspace @dsh-store/web",
    "cf-typecheck": "npm run cf-typecheck --workspace @dsh-store/web",
    "predeploy": "npm run build",
    "deploy": "npm run deploy:worker --workspace @dsh-store/web"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
