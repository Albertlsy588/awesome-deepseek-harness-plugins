{
  "name": "dsh-1024store",
  "description": "The 1024 Store plugin market inside DeepSeek Harness.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "homepage": "https://deepseek1024.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsai-sh/awesome-deepseek-harness-plugins.git",
    "directory": "packages/dsh-1024store"
  },
  "bugs": {
    "url": "https://github.com/imsai-sh/awesome-deepseek-harness-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "plugin-marketplace",
    "1024"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "client",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs && node scripts/preflight.mjs",
    "prepack": "npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
