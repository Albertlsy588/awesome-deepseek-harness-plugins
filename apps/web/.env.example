# Optional for fallback-only local development; required for production discovery.
GITHUB_TOKEN=

# Required for install-event ingestion. Generate a stable value with:
# openssl rand -hex 32
INSTALL_CLIENT_HASH_SECRET=

# Required for POST /api/v1/catalog/sync (GitHub CI curated-catalog reconciliation).
# Generate with: openssl rand -hex 32
CATALOG_SYNC_TOKEN=

# Absolute origin for the plugin API when the frontend is served from another host,
# e.g. https://example.com. Leave empty for the same-origin default.
VITE_API_ORIGIN=
