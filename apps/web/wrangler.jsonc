{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dsh-store",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "kv_namespaces": [
    {
      "binding": "CATALOG_CACHE"
    }
  ],
  "d1_databases": [
    {
      "binding": "STAR_HISTORY",
      "database_name": "dsh-store-star-history",
      "database_id": "57006b9f-17e1-466f-b941-71c35cbff092",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STATS",
        "class_name": "LiveStats"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveStats"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
