{
  "name": "@dsh-1024store/community",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:worker": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply CATALOG_DB --local --persist-to ../web/.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply CATALOG_DB --remote",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:visual": "node scripts/visual-check.mjs",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@dsh-1024store/core": "*",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
